NODE_ENV=development
PORT=8080

# Meta App Dashboard -> App settings. Never expose these to the Android client.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Comma-separated list of webhook fields subscribed in the Meta App Dashboard.
META_WEBHOOK_ALLOWED_FIELDS=messages,messaging_postbacks

# OAuth is intentionally disabled until an authenticated tenant/session adapter
# and persistent encrypted token storage are implemented.
META_OAUTH_ENABLED=false
