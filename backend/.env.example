NODE_ENV=development
PORT=8080
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v27.0
# Instagram Login: https://graph.instagram.com
# Facebook Login for Business / linked Page: https://graph.facebook.com
META_GRAPH_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Example: [{"keywords":["blue shirt","shirt"],"url":"https://shop.example.com/products/blue-shirt","title":"Blue Shirt"}]
PRODUCT_LINKS_JSON=[]
DATABASE_PATH=./data/androidinstadm.sqlite
AUTO_REPLY_ENABLED=false
MAX_MESSAGE_AGE_HOURS=24
